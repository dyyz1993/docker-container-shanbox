server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    set $auth_ok 0;

    if ($access_policy = "public") {
        set $auth_ok 1;
    }

    if ($is_local = 1) {
        set $auth_ok 1;
    }

    location / {
        if ($access_policy = "key") {
            if ($arg_key = "") {
                return 401 '{"error":"missing key parameter"}';
            }
            set $auth_ok 1;
        }

        if ($access_policy = "header") {
            if ($http_x_auth_token = "") {
                return 401 '{"error":"missing auth header"}';
            }
        }

        if ($access_policy = "private") {
            if ($is_local = 0) {
                return 403 '{"error":"forbidden"}';
            }
        }

        if ($backend_type = "") {
            return 404;
        }

        if ($backend_type = "static") {
            root /var/www/$host;
        }

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($backend_type = "proxy") {
            proxy_pass http://127.0.0.1:$backend_port;
        }
    }
}
