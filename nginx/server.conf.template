server {
    listen 80;
    server_name _;

    resolver 127.0.0.11 valid=30s;

    client_max_body_size 1024M;
    error_page 498 = @need_auth;
    error_page 502 = @backend_error;
    error_page 503 = @backend_error;
    error_page 504 = @backend_error;

    set $admin_deny 0;
    if ($http_x_real_ip !~ ^(10\.|192\.168\.|127\.)) { set $admin_deny 1; }
    if ($http_x_real_ip = "") { set $admin_deny 0; }

    location /__admin__/ {
        if ($admin_deny = 1) { return 403; }
        alias /usr/share/nginx/admin/;
        index index.html;
    }

    location /__api__/ {
        if ($admin_deny = 1) { return 403; }
        proxy_pass http://127.0.0.1:9999/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /__auth__/ {
        alias /usr/share/nginx/auth/;
    }

    location / {
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;
        add_header Access-Control-Max-Age 86400 always;

        if ($request_method = OPTIONS) {
            return 204;
        }

        set $lan_blocked "0";
        if ($lan_only = 1)              { set $lan_blocked "1"; }
        if ($is_local = 1)              { set $lan_blocked "0"; }
        if ($is_real_local = 1)         { set $lan_blocked "0"; }
        if ($is_peer  = 1)              { set $lan_blocked "0"; }
        if ($remote_addr ~ ^10\.)       { set $lan_blocked "0"; }
        if ($lan_blocked = "1")         { return 403; }

        set $auth_key_fail "0";
        if ($access_policy = "key")     { set $auth_key_fail "1"; }
        if ($access_policy = "public")  { set $auth_key_fail "0"; }
        if ($is_local = 1)              { set $auth_key_fail "0"; }
        if ($is_real_local = 1)         { set $auth_key_fail "0"; }
        if ($is_peer  = 1)              { set $auth_key_fail "0"; }
        if ($key_valid = 1)             { set $auth_key_fail "0"; }

        set $auth_header_fail "0";
        if ($access_policy = "header")  { set $auth_header_fail "1"; }
        if ($access_policy = "public")  { set $auth_header_fail "0"; }
        if ($is_local = 1)              { set $auth_header_fail "0"; }
        if ($is_real_local = 1)         { set $auth_header_fail "0"; }
        if ($is_peer  = 1)              { set $auth_header_fail "0"; }
        if ($http_x_auth_token != "")   { set $auth_header_fail "0"; }

        set $auth_private_fail "0";
        if ($access_policy = "private") { set $auth_private_fail "1"; }
        if ($access_policy = "public")  { set $auth_private_fail "0"; }
        if ($is_local = 1)              { set $auth_private_fail "0"; }
        if ($is_real_local = 1)         { set $auth_private_fail "0"; }
        if ($is_peer  = 1)              { set $auth_private_fail "0"; }

        set $auth_fail "0";
        if ($auth_key_fail     = "1") { set $auth_fail "1"; }
        if ($auth_header_fail  = "1") { set $auth_fail "1"; }
        if ($auth_private_fail = "1") { set $auth_fail "1"; }

        if ($auth_fail = "1") { return 498; }
        if ($backend_port = 0) { return 404; }

        set $upstream_host "127.0.0.1";
        if ($backend_host != "") { set $upstream_host $backend_host; }

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://$upstream_host:$backend_port;
    }

    location @need_auth {
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
        add_header Access-Control-Allow-Headers "*" always;

        set $ext_proto $scheme;
        set $ext_port "";
        if ($http_x_forwarded_proto) { set $ext_proto $http_x_forwarded_proto; }
        if ($ext_proto = "https") { set $ext_port ":8443"; }
        if ($http_accept ~* "text/html") {
            return 302 $ext_proto://$host$ext_port/__auth__/?from=$ext_proto://$host$ext_port$request_uri;
        }
        default_type application/json;
        return 401 '{"error":"unauthorized","message":"authentication required"}';
    }

    location @backend_error {
        add_header Access-Control-Allow-Origin * always;
        default_type application/json;
        return 502 '{"error":"backend_unreachable","message":"the backend service is not responding. it may be down or the port is not listening."}';
    }
}
