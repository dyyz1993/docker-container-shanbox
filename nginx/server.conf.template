server {
    listen 80;
    server_name _;

    client_max_body_size 1024M;
    error_page 498 = @need_auth;

    set $admin_deny 0;
    if ($http_x_real_ip !~ ^(10\.|192\.168\.|127\.)) {
        set $admin_deny 1;
    }
    if ($http_x_real_ip = "") {
        set $admin_deny 0;
    }

    location /__admin__/ {
        if ($admin_deny = 1) { return 403; }
        alias /usr/share/nginx/admin/;
        index index.html;
    }

    location /__api__/ {
        if ($admin_deny = 1) { return 403; }
        proxy_pass http://127.0.0.1:9999/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /__auth__/ {
        alias /usr/share/nginx/auth/;
    }

    location / {
        set $auth_key_fail "0";

        if ($access_policy = "key")     { set $auth_key_fail "1"; }
        if ($access_policy = "public")  { set $auth_key_fail "0"; }
        if ($is_local = 1)              { set $auth_key_fail "0"; }
        if ($is_real_local = 1)         { set $auth_key_fail "0"; }
        if ($is_peer  = 1)              { set $auth_key_fail "0"; }
        if ($arg_key != "")             { set $auth_key_fail "0"; }

        set $auth_header_fail "0";

        if ($access_policy = "header")  { set $auth_header_fail "1"; }
        if ($access_policy = "public")  { set $auth_header_fail "0"; }
        if ($is_local = 1)              { set $auth_header_fail "0"; }
        if ($is_real_local = 1)         { set $auth_header_fail "0"; }
        if ($is_peer  = 1)              { set $auth_header_fail "0"; }
        if ($http_x_auth_token != "")   { set $auth_header_fail "0"; }

        set $auth_private_fail "0";

        if ($access_policy = "private") { set $auth_private_fail "1"; }
        if ($access_policy = "public")  { set $auth_private_fail "0"; }
        if ($is_local = 1)              { set $auth_private_fail "0"; }
        if ($is_real_local = 1)         { set $auth_private_fail "0"; }
        if ($is_peer  = 1)              { set $auth_private_fail "0"; }

        set $auth_fail "0";
        if ($auth_key_fail     = "1") { set $auth_fail "1"; }
        if ($auth_header_fail  = "1") { set $auth_fail "1"; }
        if ($auth_private_fail = "1") { set $auth_fail "1"; }

        if ($auth_fail = "1") { return 498; }

        if ($backend_port = 0) { return 404; }

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass http://127.0.0.1:$backend_port;
    }

    location @need_auth {
        if ($http_accept ~* "text/html") {
            return 302 $scheme://$host/__auth__/?from=$scheme://$host$request_uri;
        }
        default_type application/json;
        return 401 '{"error":"unauthorized","message":"authentication required"}';
    }
}
