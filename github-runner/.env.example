# 复制为 .env 后填写；.env 已被仓库 .gitignore 覆盖，不会提交

# --- 注册目标（二选一）---
# org 级（推荐：一次注册，org 下所有仓库可用）：https://github.com/<你的org名>
# 仓库级：https://github.com/<owner>/<repo>
RUNNER_URL=https://github.com/dyyz1993

# classic PAT（Settings → Developer settings → Personal access tokens (classic)）
# org 级：admin:org；仓库级：repo
GITHUB_TOKEN=

# 自定义标签，workflow 里用 runs-on: [self-hosted, nas] 引用
# （self-hosted / linux / x64 由 runner 自动附带）
RUNNER_LABELS=nas

# 多实例时每个实例设不同名字（--replace 靠它清理同名旧 runner）
# RUNNER_NAME=gha-runner-1

TZ=Asia/Shanghai

# SSH 调试入口公钥（ssh-rsa AAAA...；留空则不启动 sshd）
SSH_PUBLIC_KEY=
# 宿主机映射端口（默认 2202，极空间上 2200/2201/2222/2223 已被占用）
# SSH_PORT=2202

# NAS 上拉取的镜像；Mac 本地构建调试可改 gha-runner:local
RUNNER_IMAGE=ghcr.io/dyyz1993/gha-runner:latest

# runner 本体版本（一般不用动，workflow 每月自动跟最新构建）
# RUNNER_VERSION=2.338.2
